{
  "name": "cleanframe",
  "version": "0.6.1",
  "private": true,
  "description": "A personal, uncluttered home interface for Samsung The Frame.",
  "scripts": {
    "dev": "python3 scripts/preview.py",
    "check": "npm run lint && python3 scripts/check.py && npm run check:device && npm run test:library",
    "package": "python3 scripts/package.py",
    "tv:info": "python3 scripts/tv.py info",
    "tv:install": "python3 scripts/tv.py install",
    "tv:launch": "python3 scripts/tv.py launch",
    "check:browser": "node scripts/check-browser.mjs",
    "dev:public": "python3 scripts/preview.py --public-fonts",
    "export:public": "python3 scripts/export-public.py",
    "check:public": "python3 scripts/check-public.py",
    "check:tools": "python3 -B scripts/test-tools.py",
    "lint": "eslint app demo/library",
    "check:device": "node --test scripts/test-device.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check:library": "node scripts/check-library.mjs",
    "check:library-perf": "node scripts/perf-library.mjs",
    "check:library-a11y": "node scripts/a11y-library.mjs",
    "build:demo": "python3 scripts/build-demo.py",
    "test:library": "node --test scripts/test-library.mjs",
    "check:mutation": "node scripts/mutate-library.mjs",
    "check:home": "npm run test:library && npm run check:mutation && npm run check:library && npm run check:library-a11y && npm run check:library-perf"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
