{
  "name": "home",
  "version": "1.0.0",
  "private": true,
  "description": "Home, a personal launcher for a Samsung Tizen TV.",
  "scripts": {
    "dev": "python3 scripts/preview.py",
    "check": "npm run lint && python3 scripts/check.py && npm run check:device && npm run test:unit",
    "tv:info": "python3 scripts/tv.py info",
    "tv:install": "python3 scripts/tv.py install",
    "tv:launch": "python3 scripts/tv.py launch",
    "check:public": "python3 scripts/check-public.py",
    "check:tools": "python3 -B scripts/test-tools.py",
    "lint": "eslint app",
    "check:device": "node --test scripts/test-device.mjs",
    "check:e2e": "node scripts/check-e2e.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "build": "python3 scripts/build.py",
    "test:unit": "node --test scripts/test-logic.mjs",
    "check:mutation": "node scripts/mutate-logic.mjs",
    "check:all": "npm run test:unit && npm run check:mutation && npm run check:e2e && npm run check:a11y && npm run check:perf"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
